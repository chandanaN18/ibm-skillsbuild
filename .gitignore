# =============================================
# Course Content Simplification Agent
# .gitignore
# =============================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/

# --- Environment Variables (keep secrets out of Git) ---
.env
.env.local
.env.*.local

# --- IDE & Editor Files ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.DS_Store

# --- Logs ---
*.log
logs/

# --- OS Files ---
Thumbs.db
Desktop.ini

# --- Node (if added later) ---
node_modules/
package-lock.json
